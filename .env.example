# =============================================================================
# Arva AI Service — Environment Configuration
# =============================================================================

# Backend API Endpoint (AquaFlow / ArvaNet Spring Boot API)
BACKEND_BASE_URL=https://api-aquaflow.gladwindr.me/api/v1

# Service Authentication Token (Bearer token for backend-mediated routes)
ARVACORE_API_TOKEN=

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Agronomic Data Sources Configuration
# Source 1: PAGASA Weather MCP Adapter
PAGASA_STATION_COVERAGE=Southern Luzon PRSD (Alabat #435 / Tayabas #434)
PAGASA_DEFAULT_PROVINCE=Quezon
PAGASA_FALLBACK_COORDINATES=13.8821,121.9906

# Source 2: Lopez Historical Agriculture MCP Adapter
LOPEZ_AGRI_MUNICIPALITY=Lopez
LOPEZ_AGRI_PROVINCE=Quezon

# Source 4: PhilRice 2003 Training Manual PDF
PHILRICE_MANUAL_PDF_PATH=Documentations/philippine-rice-production-training-manual.pdf
PHILRICE_MANUAL_INDEX_CACHE=ArvaAI/app/services/philrice_manual_index.json

# Operational Parameters
MAX_TOOL_ROUNDS=4
REQUEST_TIMEOUT_SECONDS=15
MAX_USER_PROMPT_LEN=500
PORT=8000
